  <property name="styleSheet">
   <string notr="true">QMainWindow {
  background-color: #f0f3f4;
}

QGroupBox {
  font-size: 11px;
  font-weight: bold;
  color: #566573;
  border: 1px solid #d5d8dc;
  border-radius: 6px;
  margin-top: 10px;
  background-color: white;
  padding-top: 6px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 5px;
  background-color: white;
}

QLineEdit, QTextEdit {
  border: 1px solid #d5d8dc;
  border-radius: 4px;
  font-size: 12px;
  padding: 4px 6px;
  background-color: white;
}

QLineEdit:focus, QTextEdit:focus {
  border-color: #1a5276;
}

QTableWidget {
  border: 1px solid #d5d8dc;
  border-radius: 4px;
  font-size: 12px;
  gridline-color: #eaecee;
}

QTableWidget::item:selected {
  background-color: #d6eaf8;
  color: #1a5276;
}

QHeaderView::section {
  background-color: #f2f3f4;
  border: none;
  border-bottom: 1px solid #d5d8dc;
  font-size: 11px;
  font-weight: bold;
  color: #566573;
  padding: 5px 8px;
}

QPushButton {
  font-size: 12px;
  border-radius: 4px;
  padding: 6px 12px;
}

QComboBox {
  border: 1px solid #d5d8dc;
  border-radius: 4px;
  font-size: 12px;
  padding: 4px 6px;
  background-color: white;
}</string>
